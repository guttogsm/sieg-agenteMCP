SIEG_BASE_URL=https://api.sieg.com

# Par obtido via cadastro aprovado em https://app.sieg.com/external-system-integration.aspx
# (usado só para gerar o JWT em /create-jwt)
SIEG_CLIENT_ID=
SIEG_SECRET_KEY=

# Duas chaves geradas em Minha Conta -> Integrações -> Gerar chave API.
# ESCRITA deve ser "Acesso total" (fullAccess), não "Apenas envio e
# escrita" — essa opção é write-only e não consegue fazer GET, o que
# quebraria fluxos que leem antes de gravar (ex.: editar), e também
# quebra Documentos Auxiliares (confirmado em teste real: a API exige
# nível de escrita mesmo pras rotas de geração de Pdf).
SIEG_API_KEY_LEITURA=
SIEG_API_KEY_ESCRITA=

# Qual provedor de IA o agente usa — "claude" (padrão) ou "gemini".
# Existe só por causa de app_factory.py:montar_cliente_ia — nenhum outro
# lugar do sistema precisa saber disso (é pra isso que ClienteIAPort
# existe). Preencha SÓ a chave do provedor escolhido abaixo.
SIEG_AGENTE_PROVEDOR_IA=claude

# Chave da API da Anthropic (Claude) — gerada em https://console.anthropic.com.
# Necessária só se SIEG_AGENTE_PROVEDOR_IA=claude. Sem isso (e sem provedor
# alternativo), `python app.py` sobe mas toda mensagem no chat volta com
# erro de autenticação.
ANTHROPIC_API_KEY=

# Chave da API do Gemini (Google) — gerada em https://aistudio.google.com/apikey.
# Necessária só se SIEG_AGENTE_PROVEDOR_IA=gemini. Alternativa pra quem não
# tem (ainda) acesso pago à API da Anthropic — ver ressalva no README sobre
# o que foi e o que não foi testado com esse provedor.
GEMINI_API_KEY=

# Opcional — modelo usado pelo agente (Claude ou Gemini, conforme
# SIEG_AGENTE_PROVEDOR_IA). Se não definir, usa o padrão embutido em
# app_factory.py:montar_cliente_ia. Pra Claude, cheque https://docs.claude.com;
# pra Gemini, https://ai.google.dev/gemini-api/docs/models — antes de trocar,
# porque os dois lançam modelo novo com frequência.
SIEG_AGENTE_MODELO=
